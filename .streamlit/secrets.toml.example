# 复制本文件为 secrets.toml（与 app 同级目录 .streamlit/ 下），填入真实值。
# secrets.toml 已在 .gitignore 中，切勿提交。
#
# Streamlit Community Cloud：在应用 Settings → Secrets 中粘贴同名键值（TOML），无需上传本文件。

DIFY_API_URL = "https://你的-dify-实例根地址"
DIFY_API_KEY = "app-xxxxxxxx"

# 可选：使用分组写法（与上面二选一即可）
# [dify]
# api_url = "https://你的-dify-实例根地址"
# api_key = "app-xxxxxxxx"
